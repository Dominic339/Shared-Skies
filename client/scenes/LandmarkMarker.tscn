[node name="BoardFaceQuad" type="MeshInstance3D" parent="."]
# Rotates the QuadMesh's default +Z-facing normal to +X -- the sign's
# own board sits in the Y-Z plane (its collision box is thin in X:
# CollisionShape3D above is 0.4 in X vs 2.7/2.4 in Y/Z), not the
# XY-facing default a fresh QuadMesh assumes. A NEW separate quad
# rather than texturing the sign model's own board surface directly:
# that surface's imported UVs tile ~130x along one axis (checked
# directly against the glTF's raw accessor data, not assumed) --
# workable for a repeating wood-grain look, useless for projecting one
# coherent custom layout. Position/size here are a best-effort estimate
# from this file's own existing measured reference points (the
# collision box's y-center, FIRST_SLOT_POSITION, STRUCTURE_TOP_HEIGHT)
# -- check once visible in Godot and nudge if it doesn't sit flush on
# the real board, same as FIRST_SLOT_POSITION/SLOT_SPACING already are.
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0, 1.4, 0.05)
cast_shadow = 0
mesh = SubResource("QuadMesh_BoardFace")
surface_material_override/0 = SubResource("StandardMaterial3D_BoardFace")
